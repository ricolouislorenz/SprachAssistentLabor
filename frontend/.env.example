# Frontend-Konfiguration (kopieren nach .env und befüllen)

# Adresse des gehosteten Backends. In der Entwicklung üblicherweise:
# http://localhost:3001
VITE_BACKEND_URL=http://localhost:3001

# Basis-Pfad für die Auslieferung. Bei GitHub Pages unter
# https://USER.github.io/REPO/ muss das auf /REPO/ stehen.
# Lokal nicht setzen (Default "/").
# VITE_BASE_PATH=/Laborassi/
