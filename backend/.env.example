# Backend-Konfiguration (kopieren nach .env und befüllen)

# OpenAI-API-Key — wird für Whisper und gpt-4.1-mini benötigt
OPENAI_API_KEY=sk-...

# Gemeinsames App-Passwort. Wenn leer, ist die Auth deaktiviert.
# Sollte ein starkes, geteiltes Passwort sein.
APP_PASSWORD=

# Erlaubte Origins für CORS, kommagetrennt. Leer = alle erlauben (nur Dev!)
# Beispiel: https://USER.github.io
ALLOWED_ORIGINS=

# Port, auf dem Express lauscht. Hosting-Provider setzen das oft selbst.
PORT=3001
